NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/postgres
BETTER_AUTH_URL=http://localhost:3000
# Generate two different random secrets, each at least 32 characters.
BETTER_AUTH_SECRET=
# Development may use both methods. Production requires all Keycloak values,
# disables email/password, and requires HTTPS issuer/base URLs.
# KEYCLOAK_ISSUER=https://keycloak.example.com/realms/emqx
# KEYCLOAK_CLIENT_ID=emqx-device-console
# KEYCLOAK_CLIENT_SECRET=replace-with-secret-store-value
# KEYCLOAK_ADMIN_ROLE=admin
# KEYCLOAK_ROLE_SOURCE=client
DEVICE_JWT_SECRET=
# Explicit local-only compatibility for an existing broker's short test key.
# Has no effect outside NODE_ENV=development; production always requires 32 characters.
DEVICE_JWT_ALLOW_INSECURE_DEV_SECRET=false
DEVICE_JWT_TTL_SECONDS=3600
# Only set when a trusted reverse proxy overwrites this header.
# AUTH_TRUSTED_IP_HEADER=x-forwarded-for
