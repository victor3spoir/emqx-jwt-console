// use prisma-8

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     TimestamptzJsDate(6) @onCreate(now())
  updatedAt     TimestamptzJsDate(6) @onCreate(now()) @onUpdate(now())
  role          String?   @default("user")
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    TimestamptzJsDate(6)?
  sessions      Session[]
  accounts      Account[]

  @@map("users")
}

model Session {
  id             String   @id
  expiresAt      TimestamptzJsDate(6)
  token          String   @unique
  createdAt      TimestamptzJsDate(6) @onCreate(now())
  updatedAt      TimestamptzJsDate(6) @onCreate(now()) @onUpdate(now())
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  TimestamptzJsDate(6)?
  refreshTokenExpiresAt TimestamptzJsDate(6)?
  scope                 String?
  password              String?
  createdAt             TimestamptzJsDate(6) @onCreate(now())
  updatedAt             TimestamptzJsDate(6) @onCreate(now()) @onUpdate(now())
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  TimestamptzJsDate(6)
  createdAt  TimestamptzJsDate(6) @onCreate(now())
  updatedAt  TimestamptzJsDate(6) @onCreate(now()) @onUpdate(now())

  @@index([identifier])
  @@map("verifications")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rate_limits")
}

enum DeviceStatus {
  active
  disabled
  revoked
}

model Device {
  id                Uuid         @id @onCreate(uuid())
  deviceId          VarChar(100) @unique @map("device_id")
  serialNumber      VarChar(100) @unique @map("serial_number")
  mqttUsername      VarChar(100) @unique @map("mqtt_username")
  deviceSecretHash  String       @map("device_secret_hash")
  deviceSecret      String       @map("device_secret")
  status            DeviceStatus @default(active)
  firmwareVersion   VarChar(50)?  @map("firmware_version")
  productModel      VarChar(100)? @map("product_model")
  createdAt         TimestamptzJsDate(6)  @onCreate(now()) @map("created_at")
  lastTokenIssuedAt TimestamptzJsDate(6)? @map("last_token_issued_at")
  revokedAt         TimestamptzJsDate(6)? @map("revoked_at")

  @@index([status, createdAt])
  @@map("devices")
}

model AuditEvent {
  id         Uuid     @id @onCreate(uuid())
  actorId    String?  @map("actor_id")
  action     String
  resourceId String?  @map("resource_id")
  outcome    String
  createdAt  TimestamptzJsDate(6) @onCreate(now()) @map("created_at")

  @@index([createdAt])
  @@index([resourceId, createdAt])
  @@map("audit_events")
}
