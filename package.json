{
  "name": "jwt-dashboard-for-emqx",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "vite build",
    "build": "vite build",
    "preview": "vite preview",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "post-cta-init": "bunx --bun create-db@latest --user-agent tanstack/tsrouter",
    "db:generate": "dotenv -- prisma generate",
    "db:push": "dotenv -- prisma db push",
    "db:migrate": "dotenv -- prisma migrate dev",
    "db:studio": "dotenv -- prisma studio",
    "db:seed": "dotenv -- prisma db seed",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "admin:bootstrap": "dotenv -- tsx prisma/seed.ts",
    "db:deploy": "dotenv -- prisma migrate deploy",
    "test:integration": "node --import tsx scripts/test-integration.mjs"
  },
  "dependencies": {
    "@faker-js/faker": "^10.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/roboto": "^5.3.0",
